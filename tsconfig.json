{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": false,
    "skipLibCheck": false,
    "sourceMap": false,
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
  }
}